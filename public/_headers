# Cloudflare static-assets headers (read by the bye-chem-demo Worker, not served).

# A demo: keep it out of search engines.
/*
  X-Robots-Tag: noindex, nofollow

# These files have a content hash in their name, so browsers may keep them for a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
