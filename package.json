{
  "name": "bye-chem",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8086",
    "web": "expo start --web --port 8086",
    "ios": "expo start --ios --port 8086",
    "gen:map": "node scripts/gen-map.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "check": "node scripts/gen-map.mjs --check && tsc --noEmit && expo lint && vitest run",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "deploy:web": "npm run build:web && cd deploy && npm run deploy"
  },
  "dependencies": {
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo-google-fonts/shippori-mincho": "^0.4.1",
    "@expo-google-fonts/stix-two-text": "^0.4.2",
    "@expo-google-fonts/zen-kaku-gothic-new": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-mathjax-svg": "^0.9.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
